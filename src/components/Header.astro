---
import SearchIcon from './icons/SearchIcon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localizePath, type Locale, type Dictionary } from '../i18n';
import { CATEGORY_ORDER, getCategoryPreviewProducts } from '../data/products';
import { getProductTranslation } from '../data/products.i18n';

export type NavKey = 'home' | 'products' | 'about' | 'blog' | 'contact';

interface Props {
  active?: NavKey;
  locale: Locale;
  t: Dictionary;
  path: string;
  /** Signed-in portal customer/staff's display name — only ever passed by
   * /portal/* pages, which already resolve this via requireApprovedPortalUser
   * / requireStaff before rendering. Every other page leaves this undefined
   * and gets the plain "Partner Portal" link, unchanged. */
  portalUserName?: string;
}

const { active, locale, t, path, portalUserName } = Astro.props;
const nav = t.common.nav;
const home = (p: string) => localizePath(locale, p);
---
<header class="site-header" id="top">
  <a class="brand" href={home('/')}>
    <img src="/assets/hadara-logo-black.png" alt="" class="hadara-header-logo" />
    <span><strong>HADARA</strong><small>HOSPITALITY</small></span>
  </a>
  <button class="menu-toggle" aria-label={nav.openMenu} aria-expanded="false" aria-controls="navigation"><span></span><span></span><span></span></button>
  <nav id="navigation" aria-label="Main navigation">
    <div class="nav-links">
      <a href={home('/')} aria-current={active === 'home' ? 'page' : undefined}>{t.common.home}</a>
      <div class="nav-products-item">
        <a href={home('/products')} aria-current={active === 'products' ? 'page' : undefined}>
          {nav.products}
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
        </a>
        <div class="nav-products-menu">
          {CATEGORY_ORDER.map((key) => (
            <div class="nav-products-cat-item">
              <a href={`${home('/products')}#${key}`} class="nav-products-cat">
                {t.common.categoryLabels[key]}
                <svg class="nav-products-cat-caret" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
              </a>
              <div class="nav-products-panel">
                {getCategoryPreviewProducts(key).map((product) => (
                  <a href={home(`/products/${product.slug}`)}>{getProductTranslation(locale, product.slug)?.name ?? product.name}</a>
                ))}
                <a class="nav-products-viewall" href={`${home('/products')}#${key}`}>{nav.viewAllProducts} <span>↗</span></a>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="nav-about-item">
        <a href={home('/about')} aria-current={active === 'about' ? 'page' : undefined}>
          {nav.aboutMenu}
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
        </a>
        <div class="nav-about-menu">
          <a href={home('/about')}>{nav.about}</a>
          <a href={`${home('/')}#approach`}>{nav.approach}</a>
          <a href={`${home('/')}#process`}>{nav.process}</a>
          <a href={home('/faq')}>FAQ</a>
        </div>
      </div>
      <a href={home('/blog')} aria-current={active === 'blog' ? 'page' : undefined}>{nav.blog}</a>
      <a href={home('/contact')} aria-current={active === 'contact' ? 'page' : undefined}>{nav.contact}</a>
    </div>
    <div class="nav-utils">
      <a class="nav-search" href={home('/search')} aria-label={nav.search}><SearchIcon /></a>
      <LanguageSwitcher locale={locale} path={path} />
      <a href="/portal/dashboard" class:list={{ 'nav-portal-signed-in': portalUserName }}>{portalUserName || 'Partner Portal'}</a>
      <a class="nav-quote" href={home('/get-a-quote')}>{nav.requestQuote} <span>↗</span></a>
    </div>
  </nav>
</header>
