---
import Header, { type NavKey } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import BackToTop from '../components/BackToTop.astro';
import TurkeyFlagIcon from '../components/icons/TurkeyFlagIcon.astro';
import '../styles/global.css';
import { SITE_URL, SITE_NAME, DEFAULT_OG_IMAGE } from '../config';
import { getDictionary, LOCALES, LOCALE_TAGS, DEFAULT_LOCALE, isRtl, localizePath, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Site-root, locale-agnostic path, e.g. "/about" or "/" for the homepage. Used for the canonical link, hreflang alternates and the language switcher. */
  path: string;
  locale?: Locale;
  ogType?: 'website' | 'product' | 'article';
  ogImage?: string;
  noindex?: boolean;
  active?: NavKey;
  showWhatsApp?: boolean;
  /** See Header.astro's own prop doc — only passed by /portal/* pages. */
  portalUserName?: string;
}

const {
  title,
  description,
  path,
  locale = DEFAULT_LOCALE,
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
  noindex = false,
  active,
  showWhatsApp = true,
  portalUserName,
} = Astro.props;

const t = getDictionary(locale);
const dir = isRtl(locale) ? 'rtl' : 'ltr';
const canonicalUrl = noindex ? undefined : `${SITE_URL}${localizePath(locale, path)}`;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---
<!doctype html>
<html lang={LOCALE_TAGS[locale]} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#1e2a38" />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="description" content={description} />
  <title>{title}</title>
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  {!noindex && LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_TAGS[l]} href={`${SITE_URL}${localizePath(l, path)}`} />)}
  {!noindex && <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${localizePath(DEFAULT_LOCALE, path)}`} />}
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  {canonicalUrl && (
    <>
      <meta property="og:type" content={ogType} />
      <meta property="og:site_name" content={SITE_NAME} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonicalUrl} />
      <meta property="og:image" content={absoluteOgImage} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={absoluteOgImage} />
    </>
  )}
  <slot name="head" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&family=Cairo:wght@400;500;600;700&family=Markazi+Text:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="announcement"><span class="announcement-location"><TurkeyFlagIcon />{t.common.announcement.location}</span> <span>✦</span> {t.common.announcement.tagline}</div>
  <Header active={active} locale={locale} t={t} path={path} portalUserName={portalUserName} />
  <slot />
  <Footer locale={locale} t={t} />
  {showWhatsApp && <WhatsAppFloat t={t} />}
  <BackToTop t={t} />
  <script>
    import '../scripts/site';
  </script>
</body>
</html>
