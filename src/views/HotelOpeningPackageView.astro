---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary, localizePath, type Locale } from '../i18n';
import { PRODUCTS, CATEGORIES, CATEGORY_ORDER } from '../data/products';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const o = t.hotelOpening;
const p = (path: string) => localizePath(locale, path);

const quoteLink = `${p('/get-a-quote')}?projectType=${encodeURIComponent('New Hotel Opening')}`;

// One representative, photographed product per category — drawn from the
// same source of truth as the products listing (src/data/products.ts), so
// this page can never show a product that doesn't exist or drift out of
// sync with the catalog.
const categoryCards = CATEGORY_ORDER.map((key) => {
  const representative = PRODUCTS.find((product) => product.category === key && product.main);
  return { key, label: CATEGORIES[key].label, image: representative?.main };
});
---
<BaseLayout title={o.title} description={o.description} path="/hotel-opening-package" locale={locale}>
  <main>
    <section class="pdp-hero">
      <div class="wrap">
        <p class="breadcrumb"><a href={p('/')}>{t.common.home}</a><span>/</span>{o.hero.label}</p>
        <p class="eyebrow light">{o.hero.eyebrow}</p>
        <h1>{o.hero.heading1} <em>{o.hero.heading2}</em></h1>
        <p class="pdp-tagline">{o.hero.body}</p>
        <a class="button button-gold" href={quoteLink}>{o.hero.cta} <span>→</span></a>
      </div>
    </section>

    <section class="package-contents wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{o.contents.eyebrow}</p>
          <h2>{o.contents.heading1} <em>{o.contents.heading2}</em></h2>
        </div>
        <p>{o.contents.body}</p>
      </div>
      <div class="package-grid">
        {categoryCards.map((card) => (
          card.image ? (
            <a class="package-card" href={`${p('/products')}#${card.key}`} style={`--card-image:url(${card.image})`}><span>{card.label}</span></a>
          ) : (
            <a class="package-card package-card-placeholder" href={`${p('/products')}#${card.key}`}><span>{card.label}</span></a>
          )
        ))}
      </div>
    </section>

    <section class="approach wrap">
      <div class="approach-heading">
        <p class="eyebrow">{o.benefits.eyebrow}</p>
        <h2>{o.benefits.heading1}<br /><em>{o.benefits.heading2}</em></h2>
        <p>{o.benefits.body}</p>
        <a class="button button-dark" href={quoteLink}>{o.benefits.cta} <span>↗</span></a>
      </div>
      <div class="benefits">
        {o.benefits.items.map((item, i) => (
          <article><span>{String(i + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></article>
        ))}
      </div>
    </section>

    <section class="process">
      <div class="wrap">
        <p class="eyebrow light">{o.process.eyebrow}</p>
        <div class="process-heading">
          <h2>{o.process.heading1}<br /><em>{o.process.heading2}</em></h2>
          <p>{o.process.body}</p>
        </div>
        <div class="steps steps-4">
          {o.process.steps.map((step, i) => (
            <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.body}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="products-cta">
      <div class="wrap">
        <div>
          <p class="eyebrow light">{o.cta.eyebrow}</p>
          <h2>{o.cta.heading1}<br /><em>{o.cta.heading2}</em></h2>
        </div>
        <a class="button button-gold" href={quoteLink}>{o.cta.button} <span>↗</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
