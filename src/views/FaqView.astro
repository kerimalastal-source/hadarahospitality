---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const faq = t.faq;
const p = (path: string) => localizePath(locale, path);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout title={faq.title} description={faq.description} path="/faq" locale={locale}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <main>
    <section class="pdp-hero"><div class="wrap"><p class="breadcrumb"><a href={p('/')}>{t.common.home}</a><span>/</span>FAQ</p><p class="eyebrow light">{faq.hero.eyebrow}</p><h1>{faq.hero.heading1} <em>{faq.hero.heading2}</em></h1><p class="pdp-tagline">{faq.hero.body}</p></div></section>
    <section class="faq-list wrap">
      {faq.items.map((item) => (
        <details class="faq-item">
          <summary>{item.q}<span>+</span></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>
    <section class="products-cta"><div class="wrap"><div><p class="eyebrow light">{faq.ctaEyebrow}</p><h2>{faq.ctaHeading1}<br /><em>{faq.ctaHeading2}</em></h2></div><a class="button button-gold" href={p('/contact')}>{faq.contactUs} <span>↗</span></a></div></section>
  </main>
</BaseLayout>
