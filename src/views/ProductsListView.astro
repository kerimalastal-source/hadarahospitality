---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRODUCTS, CATEGORIES, CATEGORY_ORDER } from '../data/products';
import { getProductTranslation } from '../data/products.i18n';
import { getDictionary, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const pp = t.productsPage;
const p = (path: string) => localizePath(locale, path);

const categoryImages: Record<string, { url: string; alt: string }> = {
  towels: { url: 'https://static.wixstatic.com/media/3510f9_64e4d5bf01d347bba5b26b2e14db43c0~mv2.jpg', alt: 'Hotel towels' },
  robes: { url: 'https://static.wixstatic.com/media/3510f9_e334fadc9f214cc7bbe0bb1050b9125c~mv2.png', alt: 'Hospitality robes and slippers' },
  'bed-linen': { url: 'https://static.wixstatic.com/media/3510f9_acfee53c28934ff28e4f1f352930fd21~mv2.jpg', alt: 'Hotel bed linen' },
  pillows: { url: 'https://static.wixstatic.com/media/3510f9_1972a7ea1d9b4470ba7478bfdb71baba~mv2.jpg', alt: 'Hotel pillows and duvets' },
  protectors: { url: 'https://static.wixstatic.com/media/nsplsh_5a56322d64347a316d306b~mv2.jpg', alt: 'Mattress protection for hotels' },
  amenities: { url: 'https://static.wixstatic.com/media/3510f9_fd456c76b4e44f8689e5b09877a749f1~mv2.jpg', alt: 'Hotel guest room amenities' },
};

function splitHeading(label: string) {
  const words = label.split(' ');
  const last = words.pop() ?? '';
  return { lead: words.join(' '), emphasis: last };
}

const categoryLabel = (key: string) => t.common.categoryLabels[key] ?? CATEGORIES[key as keyof typeof CATEGORIES].label;
---
<BaseLayout title={pp.title} description={pp.description} path="/products.html" locale={locale} active="products">
  <main>
    <section class="products-hero"><div class="wrap"><p class="eyebrow light">{pp.hero.eyebrow}</p><h1>{pp.hero.heading1}<br /><em>{pp.hero.heading2}</em></h1><p>{pp.hero.body}</p></div></section>
    <nav class="product-jump wrap" aria-label="Product categories">
      {CATEGORY_ORDER.map((key) => <a href={`#${key}`}>{categoryLabel(key)}</a>)}
    </nav>
    <div class="product-list wrap">
      {CATEGORY_ORDER.map((key, i) => {
        const products = PRODUCTS.filter((pr) => pr.category === key);
        const image = categoryImages[key];
        const { lead, emphasis } = splitHeading(categoryLabel(key));
        return (
          <section class="product-category" id={key}>
            <div class="product-image" data-bg={image.url} role="img" aria-label={image.alt}></div>
            <div class="product-copy">
              <span class="product-number">{String(i + 1).padStart(2, '0')} / COLLECTION</span>
              <h2>{lead} <em>{emphasis}.</em></h2>
              <p>{pp.categoryBodies[key]}</p>
              <ul>
                {products.map((pr) => (
                  <li><a href={p(`/products/${pr.slug}.html`)}>{getProductTranslation(locale, pr.slug)?.name ?? pr.name}</a></li>
                ))}
              </ul>
              <a class="text-link" href={p('/get-a-quote.html')}>{pp.cta} <span>↗</span></a>
            </div>
          </section>
        );
      })}
    </div>
    <section class="products-cta"><div class="wrap"><div><p class="eyebrow light">SOURCING SUPPORT</p><h2>{pp.sourcingHeading1}<br /><em>{pp.sourcingHeading2}</em></h2></div><a class="button button-gold" href={p('/get-a-quote.html')}>{pp.tailoredQuote} <span>↗</span></a></div></section>
  </main>
</BaseLayout>
