---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, getRelatedProducts, type Product } from '../data/products';
import { getProductTranslation } from '../data/products.i18n';
import { SITE_URL } from '../config';
import { getDictionary, localizePath, type Locale } from '../i18n';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const t = getDictionary(locale);
const pd = t.productDetail;
const category = CATEGORIES[product.category];
const categoryLabel = t.common.categoryLabels[product.category] ?? category.label;
const pageUrl = `${SITE_URL}${localizePath(locale, `/products/${product.slug}`)}`;
const p = (path: string) => localizePath(locale, path);

// Localized text falls back to the English data whenever a translation
// hasn't been filled in yet for this product/locale/field.
const tr = getProductTranslation(locale, product.slug);
const name = tr?.name ?? product.name;
const overview = tr?.overview ?? product.overview;
const material = tr?.material ?? product.material;
const suitableFor = tr?.suitableFor ?? product.suitableFor;
const specLabel = tr?.specLabel ?? product.specLabel;
const specValues = tr?.specValues ?? product.specValues;
const customization = tr?.customization ?? product.customization;
const features = tr?.features ?? product.features;

function splitName(productName: string) {
  const parts = productName.split(' – ');
  return parts.length === 2 ? { base: parts[0], suffix: parts[1] } : { base: productName, suffix: '' };
}
const { base: heroBase, suffix: heroSuffix } = splitName(name);

// The quote link and mailto body always use the canonical English product
// name/category so the resulting email stays consistent for the owner,
// regardless of which language the visitor's page was in.
// Generic product metadata handed off to the RFQ form — new fields (thread
// count, size, SKU, ...) can be added here later without the form needing
// any changes, since it just reads whichever params are present.
const quoteParams = new URLSearchParams({ product: product.name, category: category.formCategory, slug: product.slug, material: product.material });
if (product.specLabel === 'GSM' && product.specValues.length) quoteParams.set('gsm', product.specValues.join(' / '));
const quoteLink = `${p('/get-a-quote')}?${quoteParams.toString()}`;
const sampleParams = new URLSearchParams(quoteParams);
sampleParams.set('sampleRequired', 'Yes');
sampleParams.set('projectType', 'Sample / Product Evaluation');
const sampleLink = `${p('/get-a-quote')}?${sampleParams.toString()}`;

const description = `${overview} ${material}. Suitable for ${suitableFor}. Request hospitality supply specifications and a tailored quote from HADARA Hospitality.`;
const metaDescription = description.length > 158 ? `${description.slice(0, 158).replace(/\s+\S*$/, '')}…` : description;
const ogImage = product.main || undefined;

const galleryExtras = product.gallery.filter((url) => url !== product.main).slice(0, 4);

const related = getRelatedProducts(product, 3);
const relatedAllSameCategory = related.every((pr) => pr.category === product.category);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description: overview,
  image: product.gallery.length ? product.gallery : product.main ? [product.main] : undefined,
  category: categoryLabel,
  material,
  url: pageUrl,
  brand: { '@type': 'Brand', name: 'HADARA Hospitality' },
  manufacturer: { '@type': 'Organization', name: 'HADARA Hospitality', url: SITE_URL },
  additionalProperty: [
    { '@type': 'PropertyValue', name: specLabel, value: specValues.join(' / ') },
    { '@type': 'PropertyValue', name: 'Suitable For', value: suitableFor },
    { '@type': 'PropertyValue', name: 'Customization', value: customization.join(', ') },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.common.home, item: `${SITE_URL}${p('/')}` },
    { '@type': 'ListItem', position: 2, name: t.common.nav.products, item: `${SITE_URL}${p('/products')}` },
    { '@type': 'ListItem', position: 3, name: categoryLabel, item: `${SITE_URL}${p('/products')}#${product.category}` },
    { '@type': 'ListItem', position: 4, name, item: pageUrl },
  ],
};

const relatedLocalized = related.map((pr) => ({
  ...pr,
  name: getProductTranslation(locale, pr.slug)?.name ?? pr.name,
  categoryLabel: t.common.categoryLabels[pr.category] ?? CATEGORIES[pr.category].label,
}));
---
<BaseLayout
  title={`${name} | HADARA Hospitality`}
  description={metaDescription}
  path={`/products/${product.slug}`}
  locale={locale}
  ogType="product"
  ogImage={ogImage}
  active="products"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <main>
    <section class="pdp-hero">
      <div class="wrap">
        <p class="breadcrumb"><a href={p('/products')}>{t.common.nav.products}</a><span>/</span><a href={`${p('/products')}#${product.category}`}>{categoryLabel}</a><span>/</span>{name}</p>
        <p class="eyebrow light">{categoryLabel.toUpperCase()}</p>
        <h1>{heroSuffix ? <>{heroBase} <em>{heroSuffix}</em></> : heroBase}</h1>
        <p class="pdp-tagline">{overview}</p>
        <div class="pdp-actions">
          <a class="button button-gold" href={quoteLink}>{pd.requestQuoteFor} <span>↗</span></a>
          <a class="button button-dark" href={sampleLink}>{pd.requestSample} <span>↗</span></a>
          <a class="button button-gold technical-sheet-download" href={`/technical-sheets/${product.slug}.pdf`} download={`${product.slug}-technical-sheet.pdf`}>{pd.downloadSheet}</a>
        </div>
      </div>
    </section>
    <section class="pdp-main wrap">
      <div class="pdp-gallery">
        {product.main ? (
          <div class="pdp-gallery-main" data-bg={product.main} role="img" aria-label={name}></div>
        ) : (
          <div class="pdp-gallery-main pdp-gallery-placeholder" role="img" aria-label={`${name} — photo coming soon`}><span>Photo coming soon</span></div>
        )}
        {galleryExtras.length > 0 && (
          <div class="pdp-gallery-thumbs">
            {galleryExtras.map((url) => <span data-bg={url}></span>)}
          </div>
        )}
      </div>
      <div class="pdp-info">
        <p class="eyebrow">{pd.overview}</p>
        <h2>{pd.builtFor1} <em>{pd.builtFor2}</em></h2>
        <div class="pdp-quickfacts">
          <span><strong>{pd.material}</strong>{material}</span>
          <span><strong>{pd.category}</strong>{categoryLabel}</span>
          <span><strong>{pd.suitableFor}</strong>{suitableFor}</span>
        </div>
        <ul class="pdp-features">
          {features.map((f) => <li>{f}</li>)}
        </ul>
        <a class="text-link" href={quoteLink}>{pd.requestQuoteFor} <span>↗</span></a>
      </div>
    </section>
    <section class="pdp-specs">
      <div class="wrap">
        <p class="eyebrow">{pd.specifications}</p>
        <h2>{pd.technicalDetails1} <em>{pd.technicalDetails2}</em></h2>
        <dl class="spec-table">
          <div class="spec-row"><dt>{pd.category}</dt><dd>{categoryLabel}</dd></div>
          <div class="spec-row"><dt>{pd.material}</dt><dd>{material}</dd></div>
          <div class="spec-row"><dt>{specLabel}</dt><dd>{specValues.join(' / ')}{(product.specLabel === 'GSM' || product.specLabel === 'Fabric Quality') && <a class="text-link" style="display:inline-block;margin-left:14px;font-size:11px" href={p('/fabric-quality-guide')}>{t.fabricGuide.hero.label} →</a>}</dd></div>
          <div class="spec-row"><dt>{pd.suitableFor}</dt><dd>{suitableFor}</dd></div>
          <div class="spec-row"><dt>{pd.customization}</dt><dd><ul class="chip-list">{customization.map((c) => <li>{c}</li>)}</ul></dd></div>
          <div class="spec-row"><dt>{pd.moq}</dt><dd>{category.moq}</dd></div>
          <div class="spec-row"><dt>{pd.leadTime}</dt><dd>{category.leadTime}</dd></div>
        </dl>
        <p class="spec-note">{pd.moqNote}</p>
        <div class="info-box"><strong>{pd.productionSupply}</strong>{pd.productionSupplyBody}</div>
      </div>
    </section>
    {relatedLocalized.length > 0 && (
      <section class="pdp-related wrap">
        <p class="eyebrow">{pd.youMayAlsoLike}</p>
        {relatedAllSameCategory
          ? <h2>{pd.moreFrom} <em>{categoryLabel}.</em></h2>
          : <h2>{pd.completeTheRoom}</h2>}
        <div class="related-grid">
          {relatedLocalized.map((pr) =>
            pr.main ? (
              <a class="related-card" href={p(`/products/${pr.slug}`)} data-bg={pr.main}><span>{pr.category !== product.category && <small>{pr.categoryLabel}</small>}{pr.name}</span></a>
            ) : (
              <a class="related-card related-card-placeholder" href={p(`/products/${pr.slug}`)}><span>{pr.category !== product.category && <small>{pr.categoryLabel}</small>}{pr.name}</span></a>
            ),
          )}
        </div>
      </section>
    )}
    <section
      class="pdp-related wrap"
      id="recently-viewed-section"
      data-current-slug={product.slug}
      data-current-name={name}
      data-current-image={product.main}
      hidden
    >
      <p class="eyebrow">{pd.recentlyViewed.eyebrow}</p>
      <h2>{pd.recentlyViewed.heading}</h2>
      <div class="related-grid" id="recently-viewed-grid"></div>
    </section>
    <section class="products-cta"><div class="wrap"><div><p class="eyebrow light">SOURCING SUPPORT</p><h2>{pd.lookingFor1}<br /><em>{pd.lookingFor2}</em></h2></div><a class="button button-gold" href={quoteLink}>{t.common.requestTailoredQuote} <span>↗</span></a></div></section>
  </main>
  <script>import '../scripts/recently-viewed';</script>
</BaseLayout>
