---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Get a Quote | HADARA Hospitality"
  description="Request a tailored quote from HADARA Hospitality for hotel textiles and guest essentials, sourced through trusted Turkish manufacturing partners."
  canonicalPath="/get-a-quote.html"
>
  <main>
    <section class="pdp-hero"><div class="wrap"><p class="breadcrumb"><a href="/index.html">Home</a><span>/</span>Get a Quote</p><p class="eyebrow light">REQUEST A QUOTE</p><h1>Let's build your<br /><em>next supply program.</em></h1><p class="pdp-tagline">Tell us about your property and what you need. We'll come back with the right specifications, samples and a tailored quotation — no obligation, no stored data.</p></div></section>
    <section class="quote-trust wrap">
      <span>Response within 1 business day</span>
      <span>Sample-first, before any bulk order</span>
      <span>Nothing is stored — your message opens in your own email app</span>
    </section>
    <section class="quote-section wrap" id="quote">
      <div>
        <p class="eyebrow">LET'S WORK TOGETHER</p>
        <h2>Let's make every stay<br /><em>feel considered.</em></h2>
        <p>Share a few details about your project below. Your message opens directly in your email app, ready to send to our team — from a single sample request to a full property supply program.</p>
        <div class="contact-details">
          <a href="mailto:partnerships@hadarahospitality.com">partnerships@hadarahospitality.com</a>
          <a href="tel:+905319309214">+90 531 930 92 14</a>
          <span>Istanbul, Türkiye</span>
        </div>
      </div>
      <form id="quote-form" class="quote-form">
        <h3>Request a quotation</h3>
        <div class="field-row">
          <label>Your name <input name="name" required autocomplete="name" placeholder="Full name" /></label>
          <label>Work email <input name="email" type="email" required autocomplete="email" placeholder="name@hotel.com" /></label>
        </div>
        <div class="field-row">
          <label>Hotel / company <input name="hotel" required placeholder="Property name" /></label>
          <label>Country <input name="country" required autocomplete="country-name" placeholder="Country" /></label>
        </div>
        <label>What do you need? <select name="category" required>
          <option value="">Select a collection</option>
          <option>Bed linen & bedding</option>
          <option>Towels & bath</option>
          <option>Robes & slippers</option>
          <option>Pillows & duvets</option>
          <option>Mattress protectors</option>
          <option>Multiple categories</option>
          <option>Other hospitality essentials</option>
        </select></label>
        <label>Project details <textarea name="details" rows="4" placeholder="Quantities, specifications, delivery timeline..."></textarea></label>
        <button class="button button-gold" type="submit">Prepare email request <span>↗</span></button>
        <p class="form-note">No information is stored by this website. Sending requires your email app.</p>
      </form>
    </section>
  </main>
</BaseLayout>
