---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PortalShell from '../../../components/PortalShell.astro';
import { requireApprovedPortalUser } from '../../../lib/portal-auth';
import { db } from '../../../db/client';
import { orders } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { ORDER_STATUS_LABELS } from '../../../lib/portal';

export const prerender = false;

const result = await requireApprovedPortalUser(Astro);
if (result instanceof Response) return result;
const identity = result;
if (identity.role === 'staff') return Astro.redirect('/portal/admin/orders');

const companyOrders = identity.companyId
  ? await db.select().from(orders).where(eq(orders.companyId, identity.companyId)).orderBy(desc(orders.updatedAt))
  : [];
---
<BaseLayout title="Orders | HADARA Partner Portal" description="Track your HADARA Hospitality orders." path="/portal/orders" noindex portalUserName={identity.fullName}>
  <PortalShell identity={identity} active="orders">
    <div class="portal-page-head"><h1>Orders</h1></div>
    {companyOrders.length === 0 ? (
      <p class="portal-empty">No orders yet. Once you submit a request for quote, it'll show up here.</p>
    ) : (
      <div class="portal-card">
        <table class="portal-table">
          <thead><tr><th>Reference</th><th>Status</th><th>Created</th><th>Last updated</th></tr></thead>
          <tbody>
            {companyOrders.map((o) => (
              <tr>
                <td><a class="text-link" href={`/portal/orders/${o.id}`}>{o.reference}</a></td>
                <td><span class="portal-status" class:list={{ 'portal-status-delivered': o.status === 'delivered' }}>{ORDER_STATUS_LABELS[o.status]}</span></td>
                <td>{new Date(o.createdAt).toLocaleString()}</td>
                <td>{new Date(o.updatedAt).toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </PortalShell>
</BaseLayout>
