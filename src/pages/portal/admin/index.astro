---
// Staff landing page — an overview instead of dropping straight into a
// list. dashboard.astro redirects staff here automatically.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PortalShell from '../../../components/PortalShell.astro';
import { requireStaff } from '../../../lib/portal-auth';
import { db } from '../../../db/client';
import { orders, portalUsers, companies } from '../../../db/schema';
import { eq, desc, ne, count } from 'drizzle-orm';
import { ORDER_STATUS_LABELS } from '../../../lib/portal';

export const prerender = false;

const result = await requireStaff(Astro);
if (result instanceof Response) return result;
const identity = result;

const [[{ pendingCount }], [{ activeOrderCount }], [{ companyCount }], recentOrders] = await Promise.all([
  db.select({ pendingCount: count() }).from(portalUsers).where(eq(portalUsers.status, 'pending')),
  db.select({ activeOrderCount: count() }).from(orders).where(ne(orders.status, 'delivered')),
  db.select({ companyCount: count() }).from(companies),
  db
    .select({ order: orders, company: companies })
    .from(orders)
    .leftJoin(companies, eq(orders.companyId, companies.id))
    .orderBy(desc(orders.updatedAt))
    .limit(6),
]);
---
<BaseLayout title="Staff overview | HADARA Partner Portal" description="Partner portal staff overview." path="/portal/admin" noindex portalUserName={identity.fullName}>
  <PortalShell identity={identity} active="admin-overview">
    <div class="portal-page-head"><h1>Staff overview</h1></div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:20px">
      <a class="portal-card" href="/portal/admin/customers" style="display:block">
        <p class="eyebrow">Pending approvals</p>
        <p style="font-size:36px;font-family:'Playfair Display','Markazi Text',serif;margin:6px 0 0">{pendingCount}</p>
      </a>
      <div class="portal-card">
        <p class="eyebrow">Active orders</p>
        <p style="font-size:36px;font-family:'Playfair Display','Markazi Text',serif;margin:6px 0 0">{activeOrderCount}</p>
      </div>
      <div class="portal-card">
        <p class="eyebrow">Companies</p>
        <p style="font-size:36px;font-family:'Playfair Display','Markazi Text',serif;margin:6px 0 0">{companyCount}</p>
      </div>
    </div>

    <div class="portal-page-head">
      <h2 style="font:22px 'Playfair Display','Markazi Text',serif;margin:0">Recent orders</h2>
      <a class="button button-gold" href="/portal/admin/orders/new">New order <span>→</span></a>
    </div>
    {recentOrders.length === 0 ? (
      <p class="portal-empty">No orders yet.</p>
    ) : (
      <div class="portal-card">
        <table class="portal-table">
          <thead><tr><th>Reference</th><th>Company</th><th>Status</th><th>Updated</th><th></th></tr></thead>
          <tbody>
            {recentOrders.map(({ order, company }) => (
              <tr>
                <td>{order.reference}</td>
                <td>{company?.name ?? '—'}</td>
                <td><span class="portal-status" class:list={{ 'portal-status-delivered': order.status === 'delivered' }}>{ORDER_STATUS_LABELS[order.status]}</span></td>
                <td>{new Date(order.updatedAt).toLocaleDateString()}</td>
                <td><a class="text-link" href={`/portal/admin/orders/${order.id}/edit`}>Manage →</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </PortalShell>
</BaseLayout>
