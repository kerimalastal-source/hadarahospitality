---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PortalShell from '../../../components/PortalShell.astro';
import { requireStaff } from '../../../lib/portal-auth';
import { db } from '../../../db/client';
import { portalUsers, companies } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';

export const prerender = false;

const result = await requireStaff(Astro);
if (result instanceof Response) return result;
const identity = result;

const rows = await db
  .select({ user: portalUsers, company: companies })
  .from(portalUsers)
  .leftJoin(companies, eq(portalUsers.companyId, companies.id))
  .orderBy(desc(portalUsers.createdAt));

const pending = rows.filter((r) => r.user.status === 'pending');
const others = rows.filter((r) => r.user.status !== 'pending');
---
<BaseLayout title="Customer approvals | HADARA Partner Portal" description="Approve or reject partner portal sign-ups." path="/portal/admin/customers" noindex>
  <PortalShell identity={identity} active="admin-customers">
    <div class="portal-page-head"><h1>Customer approvals</h1></div>

    <div class="portal-card">
      <p class="eyebrow">Pending review ({pending.length})</p>
      {pending.length === 0 ? (
        <p class="portal-empty">Nothing waiting on review.</p>
      ) : (
        <table class="portal-table">
          <thead><tr><th>Name</th><th>Company</th><th>Email</th><th>Signed up</th><th></th></tr></thead>
          <tbody>
            {pending.map(({ user, company }) => (
              <tr>
                <td>{user.fullName}</td>
                <td>{company?.name}{company?.country ? ` · ${company.country}` : ''}</td>
                <td>{user.email}</td>
                <td>{new Date(user.createdAt).toLocaleDateString()}</td>
                <td style="display:flex;gap:10px">
                  <form method="post" action="/portal-actions/approve-customer">
                    <input type="hidden" name="userId" value={user.id} />
                    <input type="hidden" name="decision" value="approved" />
                    <button class="button button-gold" type="submit" style="min-height:36px;padding:0 14px">Approve</button>
                  </form>
                  <form method="post" action="/portal-actions/approve-customer">
                    <input type="hidden" name="userId" value={user.id} />
                    <input type="hidden" name="decision" value="rejected" />
                    <button class="button button-dark" type="submit" style="min-height:36px;padding:0 14px">Reject</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    <div class="portal-card">
      <p class="eyebrow">All accounts</p>
      <table class="portal-table">
        <thead><tr><th>Name</th><th>Company</th><th>Role</th><th>Status</th></tr></thead>
        <tbody>
          {others.map(({ user, company }) => (
            <tr>
              <td>{user.fullName}</td>
              <td>{company?.name ?? '—'}</td>
              <td>{user.role}</td>
              <td>{user.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </PortalShell>
</BaseLayout>
