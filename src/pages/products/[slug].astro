---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCTS, CATEGORIES, type Product } from '../../data/products';
import { SITE_URL } from '../../config';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const category = CATEGORIES[product.category];
const pageUrl = `${SITE_URL}/products/${product.slug}.html`;

function splitName(name: string) {
  const parts = name.split(' – ');
  return parts.length === 2 ? { base: parts[0], suffix: parts[1] } : { base: name, suffix: '' };
}
const { base: heroBase, suffix: heroSuffix } = splitName(product.name);

const quoteParams = new URLSearchParams({ product: product.name, category: category.formCategory });
const quoteLink = `/get-a-quote.html?${quoteParams.toString()}`;

const description = `${product.overview} ${product.material}. Suitable for ${product.suitableFor}. Request hospitality supply specifications and a tailored quote from HADARA Hospitality.`;
const metaDescription = description.length > 158 ? `${description.slice(0, 158).replace(/\s+\S*$/, '')}…` : description;
const ogImage = product.main || undefined;

const galleryExtras = product.gallery.filter((url) => url !== product.main).slice(0, 4);

const related = PRODUCTS.filter((p) => p.category === product.category && p.slug !== product.slug).slice(0, 3);

const PRODUCTION_NOTE = 'All products are supplied through trusted Turkish manufacturing partners with hospitality-focused production standards. Customized production, private labeling, and bulk supply solutions are available upon request.';

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.overview,
  image: product.gallery.length ? product.gallery : product.main ? [product.main] : undefined,
  category: category.label,
  material: product.material,
  url: pageUrl,
  brand: { '@type': 'Brand', name: 'HADARA Hospitality' },
  manufacturer: { '@type': 'Organization', name: 'HADARA Hospitality', url: SITE_URL },
  additionalProperty: [
    { '@type': 'PropertyValue', name: product.specLabel, value: product.specValues.join(' / ') },
    { '@type': 'PropertyValue', name: 'Suitable For', value: product.suitableFor },
    { '@type': 'PropertyValue', name: 'Customization', value: product.customization.join(', ') },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${SITE_URL}/products.html` },
    { '@type': 'ListItem', position: 3, name: category.label, item: `${SITE_URL}/products.html#${product.category}` },
    { '@type': 'ListItem', position: 4, name: product.name, item: pageUrl },
  ],
};
---
<BaseLayout
  title={`${product.name} | HADARA Hospitality`}
  description={metaDescription}
  canonicalPath={`/products/${product.slug}.html`}
  ogType="product"
  ogImage={ogImage}
  active="products"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <main>
    <section class="pdp-hero">
      <div class="wrap">
        <p class="breadcrumb"><a href="/products.html">Products</a><span>/</span><a href={`/products.html#${product.category}`}>{category.label}</a><span>/</span>{product.name}</p>
        <p class="eyebrow light">{category.label.toUpperCase()}</p>
        <h1>{heroSuffix ? <>{heroBase} <em>{heroSuffix}</em></> : heroBase}</h1>
        <p class="pdp-tagline">{product.overview}</p>
        <div class="pdp-actions">
          <a class="button button-gold" href={quoteLink}>Request a quote for this product <span>↗</span></a>
          <a class="button button-gold technical-sheet-download" href={`/technical-sheets/${product.slug}.pdf`} download={`${product.slug}-technical-sheet.pdf`}>Download Technical Sheet ↓</a>
        </div>
      </div>
    </section>
    <section class="pdp-main wrap">
      <div class="pdp-gallery">
        {product.main ? (
          <div class="pdp-gallery-main" data-bg={product.main} role="img" aria-label={product.name}></div>
        ) : (
          <div class="pdp-gallery-main pdp-gallery-placeholder" role="img" aria-label={`${product.name} — photo coming soon`}><span>Photo coming soon</span></div>
        )}
        {galleryExtras.length > 0 && (
          <div class="pdp-gallery-thumbs">
            {galleryExtras.map((url) => <span data-bg={url}></span>)}
          </div>
        )}
      </div>
      <div class="pdp-info">
        <p class="eyebrow">OVERVIEW</p>
        <h2>Built for <em>hospitality use.</em></h2>
        <div class="pdp-quickfacts">
          <span><strong>Material</strong>{product.material}</span>
          <span><strong>Category</strong>{category.label}</span>
          <span><strong>Suitable for</strong>{product.suitableFor}</span>
        </div>
        <ul class="pdp-features">
          {product.features.map((f) => <li>{f}</li>)}
        </ul>
        <a class="text-link" href={quoteLink}>Request a quote for this product <span>↗</span></a>
      </div>
    </section>
    <section class="pdp-specs">
      <div class="wrap">
        <p class="eyebrow">SPECIFICATIONS</p>
        <h2>Technical <em>details.</em></h2>
        <dl class="spec-table">
          <div class="spec-row"><dt>Category</dt><dd>{category.label}</dd></div>
          <div class="spec-row"><dt>Material</dt><dd>{product.material}</dd></div>
          <div class="spec-row"><dt>{product.specLabel}</dt><dd>{product.specValues.join(' / ')}</dd></div>
          <div class="spec-row"><dt>Suitable For</dt><dd>{product.suitableFor}</dd></div>
          <div class="spec-row"><dt>Customization</dt><dd><ul class="chip-list">{product.customization.map((c) => <li>{c}</li>)}</ul></dd></div>
        </dl>
        <div class="info-box"><strong>Production &amp; Supply</strong>{PRODUCTION_NOTE}</div>
      </div>
    </section>
    {related.length > 0 && (
      <section class="pdp-related wrap">
        <p class="eyebrow">YOU MAY ALSO LIKE</p>
        <h2>More from <em>{category.label}.</em></h2>
        <div class="related-grid">
          {related.map((p) =>
            p.main ? (
              <a class="related-card" href={`/products/${p.slug}.html`} data-bg={p.main}><span>{p.name}</span></a>
            ) : (
              <a class="related-card related-card-placeholder" href={`/products/${p.slug}.html`}><span>{p.name}</span></a>
            ),
          )}
        </div>
      </section>
    )}
    <section class="products-cta"><div class="wrap"><div><p class="eyebrow light">SOURCING SUPPORT</p><h2>Looking for a particular<br /><em>specification?</em></h2></div><a class="button button-gold" href={quoteLink}>Request a tailored quote <span>↗</span></a></div></section>
  </main>
</BaseLayout>
