---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact | HADARA Hospitality"
  description="Contact HADARA Hospitality: hotel textile and guest essentials suppliers based in Beylikdüzü, Istanbul, Türkiye."
  canonicalPath="/contact.html"
  active="contact"
>
  <main>
    <section class="pdp-hero"><div class="wrap"><p class="breadcrumb"><a href="/index.html">Home</a><span>/</span>Contact</p><p class="eyebrow light">CONTACT</p><h1>Let's start<br /><em>a conversation.</em></h1><p class="pdp-tagline">Reach our team directly, or send a message below — we're based in Beylikdüzü, Istanbul, and ready to help with your hotel textile and guest essentials program.</p></div></section>
    <section class="quote-trust wrap">
      <span>Response within 1 business day</span>
      <span>Direct line to our Istanbul team</span>
      <span>Nothing is stored — your message opens in your own email app</span>
    </section>
    <section class="quote-section wrap">
      <div>
        <p class="eyebrow">GET IN TOUCH</p>
        <h2>We'd love to<br /><em>hear from you.</em></h2>
        <p>Whether it's a product question, a partnership inquiry or press, send us a message and our team in Istanbul will get back to you directly.</p>
        <div class="contact-details">
          <a href="mailto:partnerships@hadarahospitality.com">partnerships@hadarahospitality.com</a>
          <a href="tel:+905319309214">+90 531 930 92 14</a>
          <span>Beylikdüzü, Istanbul, Türkiye</span>
        </div>
      </div>
      <form id="contact-form" class="quote-form">
        <h3>Send us a message</h3>
        <div class="field-row">
          <label>Your name <input name="name" required autocomplete="name" placeholder="Full name" /></label>
          <label>Your email <input name="email" type="email" required autocomplete="email" placeholder="name@hotel.com" /></label>
        </div>
        <label>Subject <input name="subject" required placeholder="What's this about?" /></label>
        <label>Message <textarea name="message" rows="5" required placeholder="Tell us how we can help..."></textarea></label>
        <button class="button button-gold" type="submit">Send message <span>↗</span></button>
        <p class="form-note">No information is stored by this website. Sending requires your email app.</p>
      </form>
    </section>
    <section class="contact-map-section wrap">
      <p class="eyebrow">FIND US</p>
      <h2>Beylikdüzü, <em>Istanbul.</em></h2>
      <div class="contact-map">
        <iframe src="https://www.google.com/maps?q=Beylikd%C3%BCz%C3%BC,+Istanbul,+Turkey&output=embed" width="100%" height="100%" style="border:0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="HADARA Hospitality location — Beylikdüzü, Istanbul"></iframe>
      </div>
    </section>
  </main>
</BaseLayout>
