---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'What is the minimum order quantity (MOQ)?',
    a: "MOQs vary by product and specification. Share your property size and requirements when requesting a quote, and we'll confirm exact minimums for your order.",
  },
  {
    q: 'Can we request samples before placing a bulk order?',
    a: "Yes. Every order goes through a sample-first process — you review and approve a physical sample before we move to production, so you know exactly what you're ordering.",
  },
  {
    q: 'How long does production and delivery take?',
    a: "Timelines depend on the product, quantity and any customization involved. We'll confirm a realistic delivery schedule as part of your quotation, before production begins.",
  },
  {
    q: 'Do you offer custom branding, embroidery or private labeling?',
    a: 'Yes, most products support custom branding — from embroidered logos on robes and towels to custom labeling on amenity bottles and packaging. Let us know what you need when requesting a quote.',
  },
  {
    q: 'What countries do you ship to?',
    a: "We're based in Istanbul, Türkiye, and work with hotels and hospitality businesses across the Gulf region and Europe. Share your destination with us and we'll confirm shipping and delivery options.",
  },
  {
    q: 'Can you match our existing linen or towel specifications exactly?',
    a: "In many cases, yes. Share your current specifications — thread count, GSM, material, size — and we'll source or manufacture the closest match, or recommend an upgraded alternative.",
  },
  {
    q: 'Are your products suitable for commercial laundry?',
    a: "Our hospitality textiles are selected and specified with commercial laundry conditions in mind. Tell us about your laundry setup and we'll recommend fabric weights and constructions suited to it.",
  },
  {
    q: 'What payment terms do you offer?',
    a: 'Payment terms are agreed per order, based on quantity and destination. Get in touch with your requirements and our team will confirm terms as part of the quotation.',
  },
  {
    q: 'How do I get started?',
    a: "Request a quote or send us a message with your property details and what you're looking for. We'll follow up with recommended specifications and next steps.",
  },
];
---
<BaseLayout
  title="FAQ | HADARA Hospitality"
  description="Answers to common questions about ordering hotel textiles and guest essentials from HADARA Hospitality — samples, minimum order quantities, customization, shipping and payment."
  canonicalPath="/faq.html"
>
  <main>
    <section class="pdp-hero"><div class="wrap"><p class="breadcrumb"><a href="/index.html">Home</a><span>/</span>FAQ</p><p class="eyebrow light">FAQ</p><h1>Questions, <em>answered.</em></h1><p class="pdp-tagline">Common questions from hotels and hospitality businesses sourcing textiles and guest essentials through HADARA Hospitality.</p></div></section>
    <section class="faq-list wrap">
      {faqs.map((item) => (
        <details class="faq-item">
          <summary>{item.q}<span>+</span></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>
    <section class="products-cta"><div class="wrap"><div><p class="eyebrow light">STILL HAVE A QUESTION?</p><h2>Talk to our<br /><em>team directly.</em></h2></div><a class="button button-gold" href="/contact.html">Contact us <span>↗</span></a></div></section>
  </main>
</BaseLayout>
