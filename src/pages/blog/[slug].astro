---
import ArticleView from '../../views/ArticleView.astro';
import { ARTICLES, type Article } from '../../data/blog';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
---
<ArticleView article={article} locale="en" />
