---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page Not Found | HADARA Hospitality"
  description="Page not found — HADARA Hospitality."
  path="/404"
  noindex
  showWhatsApp={false}
>
  <main>
    <section class="pdp-hero"><div class="wrap"><p class="eyebrow light">404</p><h1>Page not<br /><em>found.</em></h1><p class="pdp-tagline">The page you're looking for doesn't exist or may have moved. Try one of the links below, or search the site.</p></div></section>
    <section class="not-found-links wrap">
      <form class="not-found-search" action="/search" method="get">
        <input type="text" name="q" placeholder="Search products, articles..." aria-label="Search" />
        <button class="button button-gold" type="submit">Search <span>↗</span></button>
      </form>
      <div class="not-found-grid">
        <a href="/"><strong>Home</strong><span>Back to the homepage</span></a>
        <a href="/products"><strong>Products</strong><span>Browse our full catalog</span></a>
        <a href="/blog"><strong>Blog</strong><span>Hospitality sourcing insights</span></a>
        <a href="/contact"><strong>Contact</strong><span>Talk to our team</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
