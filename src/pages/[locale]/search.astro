---
import SearchView from '../../views/SearchView.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<SearchView locale={locale} />
