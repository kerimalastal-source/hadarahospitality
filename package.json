{
  "name": "hadara-hospitality",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:sitemap": "tsx scripts/build-sitemap.ts",
    "generate:search": "tsx scripts/build-search-index.ts",
    "generate:technical-sheets": "tsx scripts/build-technical-sheets.ts",
    "generate": "npm run generate:sitemap && npm run generate:search && npm run generate:technical-sheets",
    "predev": "npm run generate",
    "dev": "astro dev --host 0.0.0.0",
    "prebuild": "npm run generate",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.1",
    "astro": "^7.3.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.10",
    "@clerk/astro": "^4.1.3",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2"
  }
}
